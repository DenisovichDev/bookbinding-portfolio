{
    "name": "bookbinding-portfolio",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "eleventy --serve",
        "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('_site', { recursive: true, force: true });\"",
        "build": "npm run clean && eleventy",
        "check": "node --test tests/templates.test.js"
    },
    "devDependencies": {
        "@11ty/eleventy": "3.1.6"
    }
}
